# ---------- Duomenų bazė (PostgreSQL) ----------
DB_NAME=reviv
DB_USER=reviv
DB_PASSWORD=<jūsų_slaptažodis>

# ---------- Prisijungimas per Google ----------
GOOGLE_CLIENT_ID=<xxxxxxxx.apps.googleusercontent.com>
ADMIN_EMAILS=<jusu.vardas@gmail.com>
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite) ----------
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
VITE_API_URL=http://localhost:8080

# ---------- OpenAI (US-4, US-7, US-11) ----------
OPENAI_API_KEY=<sk-...>
OPENAI_EXTRACTION_ENABLED=true
OPENAI_ANALYSIS_ENABLED=true
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_PLAN_ENABLED=true
OPENAI_PLAN_MODEL=gpt-6-luna
OPENAI_PLAN_MAX_OUTPUT_TOKENS=6500

# ---------- Web Push priminimai (US-12) ----------
VAPID_PUBLIC_KEY=<Public Key>
VAPID_PRIVATE_KEY=<Private Key>
VAPID_SUBJECT=mailto:<jusu.vardas@gmail.com>